{
  "buildCommand": "echo 'pre-built'",
  "outputDirectory": "dist",
  "installCommand": "echo 'skip'",
  "framework": null,
  "functions": {
    "api/garmin.py": {
      "maxDuration": 300,
      "excludeFiles": "{dist/**,scripts/**,docs/**,.local/**,supabase/**}"
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/downloads/:path*",
      "destination": "/downloads/:path*"
    },
    {
      "source": "/api/garmin",
      "destination": "/api/garmin"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
