{
  "expo": {
    "name": "Sage",
    "slug": "sage",
    "version": "1.0.0",
    "scheme": "sage",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abhayjain.sage.dev.f6afk24zxk",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sage uses your precise location to record workout routes and find nearby training sessions.",
        "NSHealthShareUsageDescription": "Sage reads your workouts to track training sessions and compute your score.",
        "NSHealthUpdateUsageDescription": "Sage does not write to Apple Health.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Sage records your workout route while your screen is locked. Location tracking stops when you pause or finish.",
        "NSLocationAlwaysUsageDescription": "Sage uses location during an active workout to keep recording while the screen is locked.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.sage.app",
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_ELEVATION_GAINED",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Sage",
      "shortName": "Sage",
      "description": "Train with the village. Compete. Improve. Win.",
      "themeColor": "#0a0a0a",
      "backgroundColor": "#0a0a0a",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sage uses your precise location to record workout routes and find nearby training sessions.",
          "locationAlwaysAndWhenInUsePermission": "Sage records your workout route while your screen is locked. Location tracking stops when you pause or finish.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-health-privacy.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
